# Server-side origin of the FastAPI orchestrator. Browser calls stay same-origin.
API_BASE_URL=https://api.pocketwatch.tech
# Local development: API_BASE_URL=http://127.0.0.1:8002
# Legacy NEXT_PUBLIC_API_BASE_URL is supported if API_BASE_URL is absent.

# Supabase (browser side): project URL and the anon / publishable key, both safe to expose.
# Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
