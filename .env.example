# Backend configuration. Copy to .env in the repository root.
# Start from the root: .venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 8002

# Optional for seeding/ingesting Nessie data; not needed to use the checked-in cache.
NESSIE_API_KEY=
NESSIE_BASE_URL=https://prod-api.nessieisreal.com

# Gemini API key from Google AI Studio. Leave empty to use readable fallback prose.
# Uses the supported google-genai SDK, with bounded output and no automatic retries.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# auto and llm both use the local natural-language parser (no paid parsing call).
# explicit only accepts narrow forms such as "Can I afford $1400 today?".
COUNTERFACTUAL_PARSER=auto

# Checked-in synthetic population and local replay storage.
COUNTERFACTUAL_CACHE_DIR=data/cache/seeded
COUNTERFACTUAL_DB_PATH=data/cache/seeded/runs.sqlite3

# Frontend origin used in replay links. For links opened on a phone, replace this
# with a frontend URL reachable from that phone, in both root and agent .env files.
REPLAY_BASE_URL=https://pocketwatch.tech
# Local development: REPLAY_BASE_URL=http://localhost:3000

# Supabase (server side only; the service role key and DATABASE_URL are secrets, never put them in web/).
# Project Settings > API: project URL and the service_role / secret key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Connect > Session pooler connection string, with your database password in place of [YOUR-PASSWORD].
DATABASE_URL=
