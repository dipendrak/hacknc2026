# Photon agent configuration. Copy to .env inside agent/, then run npm run dev.
# These are Photon credentials, separate from the backend's Gemini API key.
# Get them from your project settings in the Photon dashboard.
PROJECT_ID=
PROJECT_SECRET=

# FastAPI backend. Local development: API_BASE_URL=http://127.0.0.1:8002
API_BASE_URL=https://api.pocketwatch.tech

# Fallback origin when the API does not return an absolute replay URL.
# Set the root .env's REPLAY_BASE_URL too: absolute URLs from the API take priority.
# For phone-accessible links, use a frontend URL reachable from the phone.
REPLAY_BASE_URL=https://pocketwatch.tech
# Local development: REPLAY_BASE_URL=http://localhost:3000

# Exact iMessage sender address -> cached customer ID. Replace the sample sender
# with YOUR sending number (including country code), not the Photon number.
# If iMessage sends from an email address, use that email as the JSON key instead.
# This example customer exists in data/cache/seeded. Add more entries as needed.
CUSTOMER_PHONE_MAP={"+15551234567":"39b2bdb2-e13c-4734-8522-1e2d43df6d1f"}

# Backend request timeout in milliseconds.
ASK_TIMEOUT_MS=20000

# Optional waiting message, sent once if the request remains pending.
# Leave INTERIM_MESSAGE_TEXT empty to disable it.
INTERIM_MESSAGE_AFTER_MS=8000
INTERIM_MESSAGE_TEXT=

# Optional thumbs-up reaction rerun. Disabled by default.
ENABLE_REACTION_RERUN=false
